# Production template. Copy to .env.production and fill every secret.
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ENABLE_DOCS=false
ENABLE_TEST_ENDPOINTS=false
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=true

ALLOWED_HOSTS=soc.example.com,localhost,127.0.0.1
CORS_ORIGINS=https://soc.example.com

SECRET_KEY=replace-with-a-unique-random-value-of-at-least-32-characters
INGEST_KEY=replace-with-a-unique-random-ingest-key
ACCESS_TOKEN_EXPIRE_HOURS=8
LOGIN_RATE_LIMIT_PER_MINUTE=10
PASSWORD_MIN_LENGTH=12

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=soc@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
BOOTSTRAP_DEMO_USERS=false

# PostgreSQL is recommended for multi-worker or multi-host deployments.
DATABASE_URL=postgresql://securewatch:replace-db-password@db:5432/securewatch
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

POSTGRES_DB=securewatch
POSTGRES_USER=securewatch
POSTGRES_PASSWORD=replace-db-password

MAX_INGEST_BATCH=500
MAX_REQUEST_BYTES=5000000
CORRELATION_WINDOW_SECONDS=300
DEDUPLICATION_WINDOW_SECONDS=300
BACKUP_RETENTION_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
MAIL_FROM=securewatch@example.com
MAIL_TO=soc@example.com

# Trust forwarded headers only when the app is reachable exclusively through
# a trusted reverse proxy (the production compose file binds to 127.0.0.1).
FORWARDED_ALLOW_IPS=*
