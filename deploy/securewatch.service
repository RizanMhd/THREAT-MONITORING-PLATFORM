[Unit]
Description=SecureWatch security incident management
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=securewatch
Group=securewatch
WorkingDirectory=/opt/securewatch
EnvironmentFile=/opt/securewatch/.env.production
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/securewatch/.venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/securewatch/data /opt/securewatch/backups
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
