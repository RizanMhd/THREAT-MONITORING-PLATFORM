# Development configuration. Copy to .env and change the keys before exposing.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ENABLE_DOCS=true
ENABLE_TEST_ENDPOINTS=true

SECRET_KEY=change-this-long-random-string
INGEST_KEY=change-this-ingest-key
ACCESS_TOKEN_EXPIRE_HOURS=8
LOGIN_RATE_LIMIT_PER_MINUTE=10
PASSWORD_MIN_LENGTH=8

ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=false

# Leave empty for the development defaults: admin/admin123 plus demo analysts.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_DEMO_USERS=true

# SQLite by default. Use DB_PATH or DATABASE_URL.
# DB_PATH=data/securewatch.db
# DATABASE_URL=postgresql://securewatch:password@localhost:5432/securewatch
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

MAX_INGEST_BATCH=500
MAX_REQUEST_BYTES=5000000
CORRELATION_WINDOW_SECONDS=300
DEDUPLICATION_WINDOW_SECONDS=300
BACKUP_RETENTION_DAYS=14

# Optional email delivery. Run tools/process_notifications.py from cron/timer.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_TLS=true
# MAIL_FROM=securewatch@example.com
# MAIL_TO=soc@example.com
